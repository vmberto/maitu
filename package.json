{
  "name": "maitu",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3000",
    "build": "if [ \"$VERCEL\" = \"1\" ]; then vite build; else CLOUDFLARE=1 vite build; fi",
    "build:cloudflare": "CLOUDFLARE=1 vite build",
    "deploy": "npm run build:cloudflare && wrangler deploy",
    "preview:cloudflare": "npm run build:cloudflare && wrangler dev",
    "start": "node --env-file-if-exists=.env build/index.js",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig tsconfig.json",
    "lint": "npm run check",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "@sveltejs/kit": "3.0.1",
    "bcryptjs": "^3.0.2",
    "jose": "^5.6.3",
    "leaflet": "^1.9.4",
    "mongodb": "^6.3.0",
    "pino": "^9.9.5",
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/adapter-vercel": "7.0.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/forms": "^0.5.7",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^22.20.5",
    "autoprefixer": "^10.4.13",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.29",
    "svelte-check": "^4.3.0",
    "tailwindcss": "^3.4.19",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "^4.0.0",
    "wrangler": "^4.148.0"
  },
  "imports": {
    "#lib/*.svelte": "./src/lib/*.svelte",
    "#lib/*": "./src/lib/*.ts"
  },
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12"
  }
}
