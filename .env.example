# Anonymous Reader requests have a lower shared IP-based rate limit.
JINA_API_KEY=
PHOTON_URL=https://photon.komoot.io/

# Smart Place inclusion uses the Workers AI binding named AI in wrangler.jsonc.
# No OpenAI API key is needed. See README for Cloudflare's free daily allowance.
