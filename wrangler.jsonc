{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maitu",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["* * * * *"] },
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "observability": {
    "enabled": true
  }
}
